set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR armv7l)
set(ATOMIC_ARM_TOOLS "/workspace/toolchains/lv2" CACHE PATH "Relocated cross-toolchain root")
set(CMAKE_SYSROOT "${ATOMIC_ARM_TOOLS}")
set(CMAKE_C_COMPILER "${ATOMIC_ARM_TOOLS}/usr/bin/arm-linux-gnueabihf-gcc-10")
set(CMAKE_CXX_COMPILER "${ATOMIC_ARM_TOOLS}/usr/bin/arm-linux-gnueabihf-g++-10")
set(CMAKE_C_FLAGS_INIT "-mcpu=cortex-a72 -mfpu=neon-vfpv4 -mfloat-abi=hard")
set(CMAKE_CXX_FLAGS_INIT "-mcpu=cortex-a72 -mfpu=neon-vfpv4 -mfloat-abi=hard")
set(CMAKE_FIND_ROOT_PATH "${ATOMIC_ARM_TOOLS}/usr/arm-linux-gnueabihf")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE BOTH)
set(CMAKE_CROSSCOMPILING_EMULATOR "${ATOMIC_ARM_TOOLS}/usr/bin/qemu-arm;-L;${ATOMIC_ARM_TOOLS}/usr/arm-linux-gnueabihf;-cpu;cortex-a15")
