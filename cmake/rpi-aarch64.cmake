set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(ATOMIC_ARM_TOOLS "/workspace/toolchains/lv2" CACHE PATH "Relocated cross-toolchain root")
set(CMAKE_SYSROOT "${ATOMIC_ARM_TOOLS}")
set(CMAKE_C_COMPILER "${ATOMIC_ARM_TOOLS}/usr/bin/aarch64-linux-gnu-gcc-10")
set(CMAKE_CXX_COMPILER "${ATOMIC_ARM_TOOLS}/usr/bin/aarch64-linux-gnu-g++-10")
set(CMAKE_C_FLAGS_INIT "-mcpu=cortex-a72")
set(CMAKE_CXX_FLAGS_INIT "-mcpu=cortex-a72")
set(CMAKE_FIND_ROOT_PATH "${ATOMIC_ARM_TOOLS}/usr/aarch64-linux-gnu")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE BOTH)
set(CMAKE_CROSSCOMPILING_EMULATOR "${ATOMIC_ARM_TOOLS}/usr/bin/qemu-aarch64;-L;${ATOMIC_ARM_TOOLS}/usr/aarch64-linux-gnu;-cpu;cortex-a72")
