set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(ATOMIC_MINGW_ROOT "/workspace/toolchains/mingw/usr" CACHE PATH "Relocatable MinGW root")
set(CMAKE_C_COMPILER "${ATOMIC_MINGW_ROOT}/bin/x86_64-w64-mingw32-gcc-posix")
set(CMAKE_CXX_COMPILER "${ATOMIC_MINGW_ROOT}/bin/x86_64-w64-mingw32-g++-posix")
set(CMAKE_RC_COMPILER "${ATOMIC_MINGW_ROOT}/bin/x86_64-w64-mingw32-windres")
set(CMAKE_FIND_ROOT_PATH "${ATOMIC_MINGW_ROOT}/x86_64-w64-mingw32")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
