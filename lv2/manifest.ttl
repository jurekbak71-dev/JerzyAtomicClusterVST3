<https://jurekbak71-dev.github.io/JerzyAtomicCluster#effect> a lv2:Plugin ; lv2:binary <atomic_cluster.so> ; rdfs:seeAlso <atomic-cluster.ttl>, <modgui.ttl> .
<https://jurekbak71-dev.github.io/JerzyAtomicCluster#effect/preset/stereo-cluster> a pset:Preset ; lv2:appliesTo <https://jurekbak71-dev.github.io/JerzyAtomicCluster#effect> ; rdfs:label "Stereo Cluster" ; rdfs:seeAlso <presets.ttl> .
<https://jurekbak71-dev.github.io/JerzyAtomicCluster#effect/preset/sharp-arp> a pset:Preset ; lv2:appliesTo <https://jurekbak71-dev.github.io/JerzyAtomicCluster#effect> ; rdfs:label "Sharp Arpeggio — BPM Sync" ; rdfs:seeAlso <presets.ttl> .
